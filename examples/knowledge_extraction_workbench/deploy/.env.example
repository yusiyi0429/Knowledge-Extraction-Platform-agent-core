# 离线包内镜像的名称与目标 CPU 架构。两者应与 export-offline-bundle.sh 的参数一致。
WORKBENCH_IMAGE=knowledge-extraction-workbench:0.1.3
WORKBENCH_PLATFORM=linux/amd64

# 监听所有网卡，供可信内网访问；如只在本机使用可改成 127.0.0.1。
WORKBENCH_BIND_ADDRESS=0.0.0.0
WORKBENCH_PUBLIC_PORT=8765
WORKBENCH_MAX_UPLOAD_BYTES=209715200
TZ=Asia/Shanghai

# HTTPS 模型地址无需配置。仅当内网模型网关只提供 HTTP 时，填写精确主机名或 IP，逗号分隔。
# 示例：model-gateway,192.168.10.20,host.docker.internal
WORKBENCH_MODEL_HTTP_HOSTS=

# 若内网需要代理再填写；模型网关和本机地址通常应加入 NO_PROXY。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,workbench
